{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "externalBin": [
      "binaries/jarvis-core"
    ],
    "resources": {
      "../../../ai/jarvis_ai/": "ai/jarvis_ai/",
      "../../../ai/requirements-voice.txt": "ai/requirements-voice.txt",
      "../../../contracts/": "contracts/",
      "python/": "python/"
    },
    "publisher": "JARVIS",
    "copyright": "Uso privato del proprietario",
    "longDescription": "JARVIS, assistente personale privato e locale: Core, runtime AI e Python inclusi.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Italian",
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "JARVIS"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 170,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 200
        }
      }
    }
  }
}
