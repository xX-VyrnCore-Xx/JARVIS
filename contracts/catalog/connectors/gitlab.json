{
  "contract": "jarvis.connector/1",
  "id": "gitlab",
  "name": "GitLab",
  "version": "1.0.0",
  "description": "Consulta i tuoi progetti e le issue GitLab.",
  "base_url": "https://gitlab.com/api/v4",
  "allowed_hosts": [
    "gitlab.com"
  ],
  "auth": {
    "type": "bearer"
  },
  "operations": [
    {
      "name": "progetti",
      "summary": "Cerca progetti GitLab di cui sei membro",
      "method": "GET",
      "path": "/projects",
      "effects": "read",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "membership": {
            "type": "boolean",
            "const": true
          },
          "search": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "membership"
        ]
      }
    },
    {
      "name": "issue",
      "summary": "Issue del progetto GitLab per ID numerico",
      "method": "GET",
      "path": "/projects/{id}/issues",
      "effects": "read",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "state": {
            "enum": [
              "opened",
              "closed",
              "all"
            ]
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "id"
        ]
      }
    }
  ]
}
