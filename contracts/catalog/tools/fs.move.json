{
  "contract": "jarvis.tool/1",
  "name": "fs.move",
  "version": "1.0.0",
  "summary": "Sposta o rinomina un file o una cartella nella workspace",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "from",
      "to"
    ],
    "properties": {
      "from": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "to": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "output_schema": {
    "type": "object"
  },
  "scope": "node",
  "effects": "write_local",
  "risk": "high",
  "permissions": [
    "node.filesystem:write"
  ],
  "errors": [
    "fs.outside_workspace",
    "fs.not_found",
    "fs.exists"
  ],
  "timeout_ms": 5000,
  "retry": {
    "mode": "never",
    "max_attempts": 1
  },
  "confirmation": "required"
}
