{
  "contract": "jarvis.tool/1",
  "name": "dataset.add_example",
  "version": "1.0.0",
  "summary": "Propone un esempio nuovo per un dataset come candidato (testo mascherato, senza doppioni): entra nel dataset solo se il proprietario lo accetta",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "text"
    ],
    "properties": {
      "name": {
        "type": "string",
        "enum": [
          "jarvis-routing",
          "jarvis-dialogue-acts",
          "jarvis-complex-requests",
          "jarvis-conversations"
        ]
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "primary": {
        "type": "string",
        "maxLength": 20
      },
      "support": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "string",
          "maxLength": 20
        }
      },
      "act": {
        "type": "string",
        "maxLength": 30
      },
      "agents": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "string",
          "maxLength": 20
        }
      },
      "expected": {
        "type": "string",
        "maxLength": 600
      }
    }
  },
  "output_schema": {
    "type": "object"
  },
  "scope": "core",
  "effects": "write_local",
  "risk": "low",
  "permissions": [
    "core.notes:write"
  ],
  "errors": [
    "dataset.invalid",
    "dataset.full"
  ],
  "timeout_ms": 10000,
  "retry": {
    "mode": "never",
    "max_attempts": 1
  },
  "confirmation": "none"
}
