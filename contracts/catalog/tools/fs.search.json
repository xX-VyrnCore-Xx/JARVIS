{
  "contract": "jarvis.tool/1",
  "name": "fs.search",
  "version": "1.0.0",
  "summary": "Cerca file nella workspace per nome e, facoltativamente, per testo contenuto",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    }
  },
  "output_schema": {
    "type": "object"
  },
  "scope": "node",
  "effects": "read",
  "risk": "low",
  "permissions": [
    "node.filesystem:read"
  ],
  "errors": [
    "fs.unavailable"
  ],
  "timeout_ms": 5000,
  "retry": {
    "mode": "safe",
    "max_attempts": 2
  },
  "confirmation": "none"
}
