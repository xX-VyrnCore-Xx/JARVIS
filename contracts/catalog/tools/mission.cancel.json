{
  "contract": "jarvis.tool/1",
  "name": "mission.cancel",
  "version": "1.0.0",
  "summary": "Annulla una missione autonoma attiva o in pausa",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 4,
        "maxLength": 32
      }
    }
  },
  "output_schema": {
    "type": "object"
  },
  "scope": "core",
  "effects": "write_local",
  "risk": "low",
  "permissions": [
    "core.mission:write"
  ],
  "errors": [
    "mission.invalid",
    "mission.limit",
    "mission.not_found",
    "mission.state",
    "mission.unavailable"
  ],
  "timeout_ms": 5000,
  "retry": {
    "mode": "never",
    "max_attempts": 1
  },
  "confirmation": "none"
}
