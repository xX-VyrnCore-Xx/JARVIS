{
  "contract": "jarvis.tool/1",
  "name": "map.route",
  "version": "1.0.0",
  "summary": "Calcola un percorso fra due luoghi (nomi o coordinate) a piedi, in bici o in auto: distanza, durata e indicazioni passo per passo in italiano",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "from",
      "to"
    ],
    "properties": {
      "from": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "to": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "mode": {
        "enum": [
          "auto",
          "piedi",
          "bici"
        ]
      }
    }
  },
  "output_schema": {
    "type": "object"
  },
  "scope": "web",
  "prerequisites": [
    "Accesso Web abilitato (JARVIS_WEB) e dominio consentito dalla policy"
  ],
  "effects": "read",
  "risk": "low",
  "permissions": [
    "web.internet:read"
  ],
  "errors": [
    "web.disabled",
    "web.unreachable",
    "web.timeout",
    "map.invalid",
    "map.not_found",
    "map.no_route",
    "map.invalid_response"
  ],
  "timeout_ms": 20000,
  "retry": {
    "mode": "safe",
    "max_attempts": 2
  },
  "confirmation": "none"
}
