{
  "contract": "jarvis.tool/1",
  "name": "memory.update",
  "version": "1.0.0",
  "summary": "Corregge il testo di un ricordo esistente per id (il proprietario ha precisato un fatto)",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "text"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "output_schema": {
    "type": "object"
  },
  "scope": "core",
  "effects": "write_local",
  "risk": "medium",
  "permissions": [
    "core.memory:write"
  ],
  "errors": [
    "memory.not_found"
  ],
  "timeout_ms": 5000,
  "retry": {
    "mode": "never",
    "max_attempts": 1
  },
  "confirmation": "none"
}
