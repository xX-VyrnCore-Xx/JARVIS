{
  "contract": "jarvis.tool/1",
  "name": "app.key",
  "version": "1.0.0",
  "summary": "Preme un tasto o una scorciatoia nell'applicazione in primo piano, dopo la conferma del proprietario",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "key"
    ],
    "properties": {
      "key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10
      },
      "modifiers": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "enum": [
            "command",
            "control",
            "option",
            "shift"
          ]
        }
      }
    }
  },
  "output_schema": {
    "type": "object"
  },
  "scope": "core",
  "prerequisites": [
    "macOS o Windows; su macOS serve il permesso Accessibilità"
  ],
  "effects": "write_local",
  "risk": "high",
  "permissions": [
    "core.desktop:execute"
  ],
  "errors": [
    "app.invalid",
    "app.unavailable",
    "app.timeout",
    "app.not_found",
    "app.permission",
    "app.failed"
  ],
  "timeout_ms": 15000,
  "retry": {
    "mode": "never",
    "max_attempts": 1
  },
  "confirmation": "required"
}
