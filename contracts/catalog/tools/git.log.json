{
  "contract": "jarvis.tool/1",
  "name": "git.log",
  "version": "1.0.0",
  "summary": "Ultimi commit del repository Git (fino a 50), anche di un solo percorso",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  },
  "output_schema": {
    "type": "object"
  },
  "scope": "core",
  "effects": "read",
  "risk": "low",
  "permissions": [
    "core.workspace:read"
  ],
  "errors": [
    "git.not_repository",
    "git.unavailable",
    "git.failed",
    "git.timeout",
    "fs.outside_workspace"
  ],
  "timeout_ms": 15000,
  "retry": {
    "mode": "safe",
    "max_attempts": 2
  },
  "confirmation": "none"
}
