{
  "contract": "jarvis.tool/1",
  "name": "n8n.create",
  "version": "1.0.0",
  "summary": "Crea nel container locale n8n una routine predefinita di promemoria o verifica audit, dopo conferma",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "kind",
      "minutes"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "kind": {
        "enum": [
          "audit",
          "reminder"
        ]
      },
      "minutes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 59
      }
    }
  },
  "output_schema": {
    "type": "object"
  },
  "scope": "core",
  "prerequisites": [],
  "effects": "write_local",
  "risk": "high",
  "permissions": [
    "core.automation:write"
  ],
  "errors": [
    "n8n.unavailable"
  ],
  "timeout_ms": 120000,
  "retry": {
    "mode": "never"
  },
  "confirmation": "required"
}
