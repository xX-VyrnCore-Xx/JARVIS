{
  "contract": "jarvis.tool/1",
  "name": "git.status",
  "version": "1.0.0",
  "summary": "Stato del repository Git della workspace: ramo, file modificati",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {}
