{
  "contract": "jarvis.tool/1",
  "name": "sandbox.prepare",
  "version": "1.0.0",
  "summary": "Costruisce in background l'immagine del terminale sandbox con Docker (serve la rete una sola volta)",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "output_schema": {
    "type": "object"
  },
  "scope": "core",
  "prerequisites": [
    "Docker locale in esecuzione"
  ],
  "effects": "write_local",
  "risk": "medium",
  "permissions": [
    "core.sandbox:execute"
  ],
  "errors": [
    "sandbox.disabled",
    "sandbox.unavailable",
    "sandbox.busy"
  ],
  "timeout_ms": 15000,
  "retry": {
    "mode": "never",
    "max_attempts": 1
  },
  "confirmation": "required"
}
