{
  "contract": "jarvis.tool/1",
  "name": "fs.usage",
  "version": "1.0.0",
  "summary": "Analizza lo spazio nella workspace: cartelle e tipi più pesanti, file grandi, duplicati e file temporanei (sola lettura)",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "top": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "min_bytes": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "output_schema": {
    "type": "object"
  },
  "scope": "node",
  "effects": "read",
  "risk": "low",
  "permissions": [
    "node.filesystem:read"
  ],
  "errors": [
    "fs.unavailable"
  ],
  "timeout_ms": 20000,
  "retry": {
    "mode": "safe",
    "max_attempts": 2
  },
  "confirmation": "none"
}
