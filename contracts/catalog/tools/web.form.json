{
  "contract": "jarvis.tool/1",
  "name": "web.form",
  "version": "1.0.0",
  "summary": "Compila un modulo di una pagina Web pubblica con un browser vero e lo invia; restituisce la pagina di risposta. Ha effetti all'esterno: richiede sempre la conferma del proprietario.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "url",
      "fields"
    ],
    "properties": {
      "url": {
        "type": "string",
        "minLength": 8,
        "maxLength": 2048
      },
      "form": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9,
        "description": "Indice del modulo nella pagina (predefinito 0)"
      },
      "fields": {
        "type": "object",
        "maxProperties": 20,
        "additionalProperties": {
          "type": [
            "string",
            "boolean",
            "number"
          ]
        },
        "description": "Valori per nome del campo"
      },
      "submit": {
        "type": "boolean",
        "description": "Invia il modulo dopo averlo compilato (predefinito vero)"
      }
    }
  },
  "output_schema": {
    "type": "object"
  },
  "scope": "web",
  "prerequisites": [
    "Conferma del proprietario con indirizzo e campi",
    "Ogni richiesta del browser passa dalla policy Web"
  ],
  "effects": "write_external",
  "risk": "high",
  "permissions": [
    "web.browser:write"
  ],
  "errors": [
    "web.browser_unavailable",
    "web.timeout",
    "web.unreachable",
    "web.element_not_found",
    "web.browser_error"
  ],
  "timeout_ms": 45000,
  "retry": {
    "mode": "never",
    "max_attempts": 1
  },
  "confirmation": "required"
}
