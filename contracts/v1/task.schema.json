{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/v1/task.schema.json",
  "title": "Task e transizioni di stato v1",
  "description": "AUTONOMY_AND_TOOLS.md: obiettivo, condizioni di successo, dipendenze, ambito e identità richiedente; ARCHITECTURE.md: il Core registra il task. RF-02. Le transizioni ammesse sono in task-transitions.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "task_id", "correlation_id", "requester", "objective", "success_conditions", "dependencies", "state", "history", "created_at"],
  "properties": {
    "contract": { "const": "jarvis.task/1" },
    "task_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "parent_task_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "correlation_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "requester": { "$ref": "common.schema.json#/$defs/actor" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "success_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/uuid" } },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
        "resources": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/resource_uri" } }
      }
    },
    "state": { "$ref": "#/$defs/state" },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to", "at", "by"],
        "properties": {
          "from": { "$ref": "#/$defs/state" },
          "to": { "$ref": "#/$defs/state" },
          "at": { "$ref": "common.schema.json#/$defs/timestamp" },
          "by": { "$ref": "common.schema.json#/$defs/actor" },
          "reason": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "error": { "$ref": "error.schema.json" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "failed" } } },
      "then": { "required": ["error"] }
    }
  ],
  "$defs": {
    "state": { "enum": ["pending", "planned", "running", "waiting_confirmation", "blocked", "succeeded", "failed", "cancelled"] }
  }
}
