{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/v1/connector.schema.json",
  "title": "Manifest di connettore v1",
  "description": "RF-14 e AUTONOMY_AND_TOOLS.md: un connettore si installa, si autorizza e si revoca; le sue operazioni diventano strumenti soggetti a policy, conferma e audit. Le credenziali non fanno mai parte del manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "name",
    "version",
    "description",
    "base_url",
    "allowed_hosts",
    "auth",
    "operations"
  ],
  "properties": {
    "contract": {
      "const": "jarvis.connector/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "base_url": {
      "type": "string",
      "pattern": "^https?://[^\\s/@]+(:[0-9]+)?(/[^\\s]*)?$",
      "maxLength": 500
    },
    "allowed_hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+$",
        "maxLength": 253
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "none",
            "bearer",
            "header",
            "oauth2"
          ]
        },
        "header_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,64}$"
        },
        "authorize_url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2000,
          "description": "Pagina di consenso del servizio, aperta nel browser del proprietario (ADR-0027)."
        },
        "token_url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2000,
          "description": "Endpoint dei token; il suo host deve comparire in allowed_hosts."
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\x21\\x23-\\x5B\\x5D-\\x7E]{1,200}$"
          },
          "maxItems": 32
        },
        "revoke_url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2000,
          "description": "Endpoint di revoca dei token (RFC 7009), facoltativo; il suo host deve comparire in allowed_hosts."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "header"
              }
            }
          },
          "then": {
            "required": [
              "header_name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "oauth2"
              }
            }
          },
          "then": {
            "required": [
              "authorize_url",
              "token_url",
              "client_id"
            ]
          }
        }
      ]
    },
    "webhook": {
      "description": "Ricezione di eventi firmati con HMAC-SHA256 (intestazione X-Jarvis-Signature: sha256=<hex>) con il segreto del connettore.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "summary",
          "method",
          "path",
          "effects",
          "input_schema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "method": {
            "enum": [
              "GET",
              "POST"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._~/{}-]*$",
            "maxLength": 300,
            "description": "I segmenti {nome} vengono sostituiti dagli argomenti (codificati)."
          },
          "effects": {
            "enum": [
              "read",
              "write_external"
            ]
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "input_schema": {
            "type": "object"
          }
        }
      }
    }
  }
}
