{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/v1/policy-decision.schema.json",
  "title": "Decisione di policy del Security Engine v1",
  "description": "SECURITY_AND_PRIVACY.md: conferma legata a parametri, destinatario ed effetto atteso; policy assente o errore di validazione interrompono l'azione. AUTONOMY_AND_TOOLS.md passo 2. RNF-04, RNF-05.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "decision_id", "request", "decision", "reasons", "risk", "policy_version", "decided_at", "expires_at"],
  "properties": {
    "contract": { "const": "jarvis.policy-decision/1" },
    "decision_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "correlation_id", "subject", "action", "resource", "node", "parameters_digest"],
      "properties": {
        "task_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "correlation_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "subject": { "$ref": "common.schema.json#/$defs/actor" },
        "on_behalf_of": { "$ref": "common.schema.json#/$defs/actor" },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "version"],
          "properties": {
            "tool": { "$ref": "common.schema.json#/$defs/identifier" },
            "version": { "$ref": "common.schema.json#/$defs/semver" }
          }
        },
        "resource": { "$ref": "common.schema.json#/$defs/resource_uri" },
        "node": { "$ref": "common.schema.json#/$defs/identifier" },
        "destination": { "enum": ["local", "core", "cloud", "external"], "default": "local" },
        "parameters_digest": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "decision": { "enum": ["allow", "deny", "require_confirmation"] },
    "reasons": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "policy_version": { "$ref": "common.schema.json#/$defs/semver" },
    "decided_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "confirmation": {
      "description": "Richiesta di conferma vincolata: vale una sola volta, per gli stessi parametri, destinazione ed effetto atteso.",
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation_id", "parameters_digest", "target", "expected_effect", "single_use", "expires_at"],
      "properties": {
        "confirmation_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "parameters_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "target": { "type": "string", "minLength": 1, "maxLength": 500 },
        "expected_effect": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "single_use": { "const": true },
        "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "require_confirmation" } } },
      "then": { "required": ["confirmation"] },
      "else": { "not": { "required": ["confirmation"] } }
    },
    {
      "description": "Il rischio alto o critico non è mai autorizzato senza conferma.",
      "if": { "properties": { "risk": { "enum": ["high", "critical"] } } },
      "then": { "properties": { "decision": { "enum": ["deny", "require_confirmation"] } } }
    }
  ]
}
