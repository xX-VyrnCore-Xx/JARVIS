{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/v1/device.schema.json",
  "title": "Dispositivo associato v1",
  "description": "RF-11 e INTERFACE_AND_DEVICES.md: un dispositivo client associato con codice monouso, con permessi limitati e revocabile. Il token del dispositivo non fa mai parte del documento: il Core ne conserva solo l'impronta.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "device_id", "name", "platform", "scopes", "enrolled_at"],
  "properties": {
    "contract": { "const": "jarvis.device/1" },
    "device_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "platform": { "enum": ["android", "ios", "desktop", "web", "other"] },
    "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["chat", "confirm"] } },
    "enrolled_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "last_seen_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "revoked_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
