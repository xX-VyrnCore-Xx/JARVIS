{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/v1/delegation.schema.json",
  "title": "Delega temporanea a un agente v1",
  "description": "AI_SYSTEM.md: obiettivo, riferimento al task, contesto minimo, strumenti, limiti, timeout e condizioni di completamento. RF-03.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "delegation_id",
    "task_id",
    "objective",
    "delegate",
    "context",
    "tools",
    "limits",
    "timeout_ms",
    "completion_conditions",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "contract": {
      "const": "jarvis.delegation/1"
    },
    "delegation_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "parent_delegation_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "delegate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "temporary"
      ],
      "properties": {
        "agent": {
          "enum": [
            "general_assistant",
            "research",
            "coding",
            "system",
            "automation",
            "planning",
            "memory",
            "vision",
            "voice",
            "monitoring",
            "business",
            "temporary"
          ]
        },
        "temporary": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "maxLength": 200
        }
      },
      "if": {
        "properties": {
          "agent": {
            "const": "temporary"
          }
        }
      },
      "then": {
        "required": [
          "role"
        ],
        "properties": {
          "temporary": {
            "const": true
          }
        }
      }
    },
    "context": {
      "description": "Contesto minimo: solo riferimenti autorizzati, non copie di memoria.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refs"
      ],
      "properties": {
        "refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/resource_uri"
          }
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "version": {
            "$ref": "common.schema.json#/$defs/semver"
          }
        }
      },
      "description": "Limite portato da 32 a 64 (ADR-0046) e da 64 a 96 (ADR-0121), aggiunte compatibili: il Core ne propone comunque al massimo 64 per richiesta."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_steps"
      ],
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_subdelegations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "allow_cloud": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "timeout_ms": {
      "$ref": "common.schema.json#/$defs/duration_ms"
    },
    "completion_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "issued_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "inputs": {
      "description": "Dati strutturati minimi per l'agente: turni recenti, memoria autorizzata, risultato di uno strumento. Aggiunta compatibile (facoltativa) della v1.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messages": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "maxLength": 8000
              }
            }
          }
        },
        "memory": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "tool_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "status",
            "output"
          ],
          "properties": {
            "tool": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "status": {
              "enum": [
                "succeeded",
                "failed",
                "denied",
                "cancelled"
              ]
            },
            "output": {}
          }
        },
        "tool_descriptors": {
          "description": "Descrittori degli strumenti dinamici (connettori RF-14) non presenti nel catalogo statico dell'agente. Aggiunta compatibile (facoltativa) della v1.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "summary",
              "input_schema"
            ],
            "properties": {
              "name": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "version": {
                "$ref": "common.schema.json#/$defs/semver"
              },
              "summary": {
                "type": "string",
                "maxLength": 500
              },
              "input_schema": {
                "type": "object"
              }
            }
          }
        },
        "tool_history": {
          "description": "Passi già eseguiti in questo turno, in ordine (ciclo dell'agente, ADR-0037). L'ultimo coincide con tool_result. Aggiunta compatibile (facoltativa) della v1.",
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "status",
              "output"
            ],
            "properties": {
              "tool": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "status": {
                "enum": [
                  "succeeded",
                  "failed",
                  "denied",
                  "cancelled"
                ]
              },
              "output": {},
              "arguments": {
                "type": "object"
              }
            }
          }
        },
        "steps_left": {
          "description": "Strumenti che l'agente può ancora chiedere in questo turno; 0 = deve rispondere. Aggiunta compatibile (facoltativa) della v1.",
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "skills": {
          "description": "Competenze del proprietario attive per questa richiesta (ADR-0048): istruzioni da seguire e strumenti suggeriti. Non ampliano i permessi.",
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "instructions"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "maxLength": 80
              },
              "instructions": {
                "type": "string",
                "maxLength": 4000
              },
              "tools": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            }
          }
        }
      }
    },
    "stream": {
      "type": "boolean",
      "default": false,
      "description": "Se vero, l'agente invia i frammenti di testo come envelope delegation.progress (status running, payload {delta}) prima dell'esito (ADR-0025)."
    }
  }
}
